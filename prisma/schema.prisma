generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      Role      @default(LECTURER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String
  admin     Admin?
  lecturer  Lecturer?
  student   Student?

  @@map("users")
}

model Lecturer {
  id                Int                      @id @default(autoincrement())
  lecturerId        String                   @unique
  name              String
  email             String                   @unique
  photo             String?
  phone             String
  address           String
  userId            Int                      @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  role              String
  title             String
  assignments       Assignment[]
  materials         CourseMaterial[]
  registrationLinks CourseRegistrationLink[]
  courses           Course[]
  lectures          Lecture[]
  exams             Exam[]
  lecturerCourses   LecturerCourse[]
  lecturerLevels    LecturerLevel[]
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons           Lesson[]
  results           Result[]
  tests             Test[]

  @@map("lecturers")
}

model Level {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  capacity       Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  announcements  Announcement[]
  assignments    Assignment[]
  events         Event[]
  exams          Exam[]
  lecturerLevels LecturerLevel[]
  lessons        Lesson[]
  results        Result[]
  students       Student[]
  tests          Test[]

  @@map("levels")
}

model Course {
  id                Int                      @id @default(autoincrement())
  name              String                   @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  code              String                   @unique
  lecturerId        Int
  level             Int
  assignments       Assignment[]
  materials         CourseMaterial[]
  registrationLinks CourseRegistrationLink[]
  registrations     CourseRegistration[]
  lectures          Lecture[]
  lecturer          Lecturer                 @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  exams             Exam[]
  lecturerCourses   LecturerCourse[]
  lessons           Lesson[]
  results           Result[]
  tests             Test[]

  @@map("courses")
}

model LecturerCourse {
  id         Int      @id @default(autoincrement())
  lecturerId Int
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, courseId])
  @@map("lecturer_courses")
}

model LecturerLevel {
  id         Int      @id @default(autoincrement())
  lecturerId Int
  levelId    Int
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, levelId])
  @@map("lecturer_levels")
}

model Student {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  photo        String?
  phone        String
  grade        Int
  levelId      Int
  address      String
  userId       Int      @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         String
  title        String
  matricNumber String   @unique
  results      Result[]
  attendances  Attendance[]
  assignmentSubmissions AssignmentSubmission[]
  testResponses TestResponse[]
  testAccesses TestAccess[]
  level        Level    @relation(fields: [levelId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Lesson {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Exam {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  results    Result[]

  @@map("exams")
}

model Assignment {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  startDate       DateTime
  dueDate         DateTime
  linkId          String   @unique
  isActive        Boolean  @default(true)
  lecturerFileUrl String?
  lecturerFileName String?
  courseId        Int
  levelId         Int
  lecturerId      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer        Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level           Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  submissions     AssignmentSubmission[]

  @@map("assignments")
}

model Result {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  studentId  Int
  examId     Int?
  date       DateTime
  type       String
  score      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam       Exam?    @relation(fields: [examId], references: [id])
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("results")
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  levelId   Int
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  levelId   Int
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  title     String
  allDay    Boolean  @default(false)
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("calendar_events")
}

model Admin {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  title     String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model CourseRegistrationLink {
  id            String               @id @default(cuid())
  courseId      Int
  lecturerId    Int
  expiresAt     DateTime
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  level         Int
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer      Lecturer             @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  registrations CourseRegistration[]

  @@map("course_registration_links")
}

model CourseRegistration {
  id           Int                    @id @default(autoincrement())
  linkId       String
  courseId     Int
  studentName  String
  studentEmail String
  studentPhone String
  status       RegistrationStatus     @default(PENDING)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  level        Int
  matricNumber String
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  link         CourseRegistrationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("course_registrations")
}

model CourseMaterial {
  id               Int      @id @default(autoincrement())
  courseId         Int
  fileUrl          String
  fileType         String
  originalFilename String
  uploadedBy       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer         Lecturer @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("course_materials")
}

model Lecture {
  id           Int        @id @default(autoincrement())
  uniqueCode   String     @unique
  startTime    DateTime
  endTime      DateTime
  linkExpiry   DateTime
  courseId     Int
  lecturerId   Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer     Lecturer   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  attendances  Attendance[]

  @@map("lectures")
}

model Attendance {
  id         Int           @id @default(autoincrement())
  lectureId  Int
  studentId  Int
  status     AttendanceStatus @default(PRESENT)
  latitude   Float?
  longitude  Float?
  markedAt   DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lecture    Lecture       @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lectureId, studentId])
  @@map("attendances")
}

model AssignmentSubmission {
  id               Int        @id @default(autoincrement())
  assignmentId     Int
  studentId        Int
  fileUrl          String
  fileName         String
  originalFilename String
  submittedAt      DateTime   @default(now())
  gradedAt         DateTime?
  grade            Int?
  feedback         String?
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Test {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lecturerId   Int
  lecturer     Lecturer      @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  levelId      Int
  level        Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  startDate    DateTime
  dueDate      DateTime
  questions    TestQuestion[]
  responses    TestResponse[]
  accesses     TestAccess[]
  shareToken   String        @unique
  isPublished  Boolean       @default(false)
  allowViewScore Boolean     @default(true)
  timeLimit    Int?          // in minutes

  @@map("tests")
}

model TestQuestion {
  id          Int           @id @default(autoincrement())
  testId      Int
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  question    String
  type        QuestionType
  options     String[]      // JSON array of options for multiple choice/checkbox
  correct     String[]      // JSON array of correct answers
  required    Boolean       @default(false)
  order       Int
  points      Int           @default(1)

  @@map("test_questions")
}

model TestResponse {
  id          Int           @id @default(autoincrement())
  testId      Int
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     Json          // { questionId: value }
  score       Float?
  submittedAt DateTime      @default(now())
  timeSpent   Int?          // in minutes

  @@unique([testId, studentId])
  @@map("test_responses")
}

// Grants per-test access to students after verification, until expiresAt
model TestAccess {
  id         Int      @id @default(autoincrement())
  testId     Int
  studentId  Int
  verified   Boolean  @default(false) // Whether student has completed verification
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@map("test_access")
}

enum QuestionType {
  SHORT_ANSWER
  PARAGRAPH
  MULTIPLE_CHOICE
  CHECKBOX
}

enum Role {
  LECTURER
  STUDENT
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}
