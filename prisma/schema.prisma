// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- User and Role ---
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(LECTURER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lecturer   Lecturer?
  student    Student?

  @@map("users")
}

enum Role {
  LECTURER
  STUDENT
  ADMIN
}

// --- Lecturer ---
model Lecturer {
  id         Int      @id @default(autoincrement())
  lecturerId String   @unique
  name       String
  email      String   @unique
  photo      String?
  phone      String
  address    String
  userId     Int      @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecturerCourses LecturerCourse[]
  lecturerLevels LecturerLevel[]
  lessons    Lesson[]
  exams      Exam[]
  assignments Assignment[]
  results    Result[]

  @@map("lecturers")
}

// --- Level ---
model Level {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  capacity   Int
  grade      Int
  supervisor String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  students   Student[]
  lecturerLevels LecturerLevel[]
  lessons    Lesson[]
  exams      Exam[]
  assignments Assignment[]
  events     Event[]
  announcements Announcement[]
  results    Result[]

  @@map("levels")
}

// --- Course ---
model Course {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lecturerCourses LecturerCourse[]
  lessons   Lesson[]
  exams     Exam[]
  assignments Assignment[]
  results   Result[]

  @@map("courses")
}

// --- Join Tables ---
model LecturerCourse {
  id        Int @id @default(autoincrement())
  lecturerId Int
  courseId   Int

  // Relations
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, courseId])
  @@map("lecturer_courses")
}

model LecturerLevel {
  id        Int @id @default(autoincrement())
  lecturerId Int
  levelId    Int

  // Relations
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, levelId])
  @@map("lecturer_levels")
}

// --- Student ---
model Student {
  id        Int      @id @default(autoincrement())
  studentId String   @unique
  name      String
  email     String   @unique
  photo     String?
  phone     String
  grade     Int
  levelId   Int
  address   String
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Level    @relation(fields: [levelId], references: [id])
  results   Result[]

  @@map("students")
}

// --- Lesson ---
model Lesson {
  id        Int      @id @default(autoincrement())
  courseId  Int
  levelId   Int
  lecturerId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lecturer  Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

// --- Exam ---
model Exam {
  id        Int      @id @default(autoincrement())
  courseId  Int
  levelId   Int
  lecturerId Int
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lecturer  Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  results   Result[]

  @@map("exams")
}

// --- Assignment ---
model Assignment {
  id        Int      @id @default(autoincrement())
  courseId  Int
  levelId   Int
  lecturerId Int
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lecturer  Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@map("assignments")
}

// --- Result ---
model Result {
  id        Int      @id @default(autoincrement())
  courseId  Int
  levelId   Int
  lecturerId Int
  studentId Int
  examId    Int?
  date      DateTime
  type      String   // "exam" or "assignment"
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lecturer  Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@map("results")
}

// --- Event ---
model Event {
  id        Int      @id @default(autoincrement())
  title     String
  levelId   Int
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@map("events")
}

// --- Announcement ---
model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  levelId   Int
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

// --- CalendarEvent ---
model CalendarEvent {
  id        Int      @id @default(autoincrement())
  title     String
  allDay    Boolean  @default(false)
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("calendar_events")
}
