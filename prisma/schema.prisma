generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      Role      @default(LECTURER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String
  admin     Admin?
  lecturer  Lecturer?
  student   Student?

  @@map("users")
}

model Lecturer {
  id                Int                      @id @default(autoincrement())
  lecturerId        String                   @unique
  name              String
  email             String                   @unique
  photo             String?
  phone             String
  address           String
  userId            Int                      @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  role              String
  title             String
  assignments       Assignment[]
  registrationLinks CourseRegistrationLink[]
  courses           Course[]
  exams             Exam[]
  lecturerCourses   LecturerCourse[]
  lecturerLevels    LecturerLevel[]
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons           Lesson[]
  results           Result[]

  @@map("lecturers")
}

model Level {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  capacity       Int
  grade          Int
  supervisor     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  announcements  Announcement[]
  assignments    Assignment[]
  events         Event[]
  exams          Exam[]
  lecturerLevels LecturerLevel[]
  lessons        Lesson[]
  results        Result[]
  students       Student[]

  @@map("levels")
}

model Course {
  id                Int                      @id @default(autoincrement())
  name              String                   @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  code              String                   @unique
  lecturerId        Int
  level             Int
  assignments       Assignment[]
  registrationLinks CourseRegistrationLink[]
  registrations     CourseRegistration[]
  lecturer          Lecturer                 @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  exams             Exam[]
  lecturerCourses   LecturerCourse[]
  lessons           Lesson[]
  results           Result[]

  @@index([lecturerId], map: "courses_lecturerId_fkey")
  @@map("courses")
}

model LecturerCourse {
  id         Int      @id @default(autoincrement())
  lecturerId Int
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, courseId])
  @@index([courseId], map: "lecturer_courses_courseId_fkey")
  @@map("lecturer_courses")
}

model LecturerLevel {
  id         Int      @id @default(autoincrement())
  lecturerId Int
  levelId    Int
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, levelId])
  @@index([levelId], map: "lecturer_levels_levelId_fkey")
  @@map("lecturer_levels")
}

model Student {
  id            Int      @id @default(autoincrement())
  matricNumber  String   @unique
  name      String
  email     String   @unique
  photo     String?
  phone     String
  grade     Int
  levelId   Int
  address   String
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String
  title     String
  results   Result[]
  level     Level    @relation(fields: [levelId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([levelId], map: "students_levelId_fkey")
  @@map("students")
}

model Lesson {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "lessons_courseId_fkey")
  @@index([lecturerId], map: "lessons_lecturerId_fkey")
  @@index([levelId], map: "lessons_levelId_fkey")
  @@map("lessons")
}

model Exam {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  results    Result[]

  @@index([courseId], map: "exams_courseId_fkey")
  @@index([lecturerId], map: "exams_lecturerId_fkey")
  @@index([levelId], map: "exams_levelId_fkey")
  @@map("exams")
}

model Assignment {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  dueDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "assignments_courseId_fkey")
  @@index([lecturerId], map: "assignments_lecturerId_fkey")
  @@index([levelId], map: "assignments_levelId_fkey")
  @@map("assignments")
}

model Result {
  id         Int      @id @default(autoincrement())
  courseId   Int
  levelId    Int
  lecturerId Int
  studentId  Int
  examId     Int?
  date       DateTime
  type       String
  score      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam       Exam?    @relation(fields: [examId], references: [id])
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "results_courseId_fkey")
  @@index([examId], map: "results_examId_fkey")
  @@index([lecturerId], map: "results_lecturerId_fkey")
  @@index([levelId], map: "results_levelId_fkey")
  @@index([studentId], map: "results_studentId_fkey")
  @@map("results")
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  levelId   Int
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([levelId], map: "events_levelId_fkey")
  @@map("events")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  levelId   Int
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([levelId], map: "announcements_levelId_fkey")
  @@map("announcements")
}

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  title     String
  allDay    Boolean  @default(false)
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("calendar_events")
}

model Admin {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  title     String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model CourseRegistrationLink {
  id            String               @id @default(cuid())
  courseId      Int
  lecturerId    Int
  expiresAt     DateTime
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  level         Int
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer      Lecturer             @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  registrations CourseRegistration[]

  @@index([courseId], map: "course_registration_links_courseId_fkey")
  @@index([lecturerId], map: "course_registration_links_lecturerId_fkey")
  @@map("course_registration_links")
}

model CourseRegistration {
  id           Int                    @id @default(autoincrement())
  linkId       String
  courseId     Int
  studentName  String
  studentEmail String
  studentPhone String
  matricNumber String
  status       RegistrationStatus     @default(PENDING)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  level        Int
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  link         CourseRegistrationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "course_registrations_courseId_fkey")
  @@index([linkId], map: "course_registrations_linkId_fkey")
  @@map("course_registrations")
}

enum Role {
  LECTURER
  STUDENT
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}
